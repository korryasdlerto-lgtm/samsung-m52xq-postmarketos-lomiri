+std::string POSIX::key(const AppID& appId, const std::string& job, const std::string& instance)
+{
+    /* not the instance: instances() (a stub) always answers "somestring", so qtmir's pid lookup never matched the
+       launch and named the window's app from its command line ("qmlkonsole", "/usr/bin/plasma-dialer"), the
+       launched app stayed "starting, no window" */
+    return std::string(appId) + "\n" + job;
+}
+
+void POSIX::childExited(GPid pid, gint status, gpointer user_data)
+{
+    auto data = static_cast<std::tuple<std::shared_ptr<manager::POSIX>, std::string, std::string, std::string>*>(user_data);
+    auto& [manager, job, appid, instance] = *data;
+    g_debug("child %d of '%s' exited, status %d", pid, appid.c_str(), status);
+    g_spawn_close_pid(pid);
+    for (auto it = manager->launchedpids.begin(); it != manager->launchedpids.end(); ++it)
+    {
+        if (it->second == pid)
+        {
+            manager->launchedpids.erase(it);
+            break;
+        }
+    }
+    manager->sig_jobStopped(job, appid, instance);
+    delete data;
+}
