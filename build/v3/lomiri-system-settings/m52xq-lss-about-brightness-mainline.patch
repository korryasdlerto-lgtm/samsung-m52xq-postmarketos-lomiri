diff -ruN a/lomiri-system-settings-1.5.0/plugins/about/storageabout.cpp b/lomiri-system-settings-1.5.0/plugins/about/storageabout.cpp
--- a/lomiri-system-settings-1.5.0/plugins/about/storageabout.cpp	2026-10-13 12:55:28.000000000 +0300
+++ b/lomiri-system-settings-1.5.0/plugins/about/storageabout.cpp	2026-10-26 01:26:56.404803265 +0200
@@ -43,7 +43,35 @@
 #include <QtGlobal>
 #include <QProcess>
 #include <QVariant>
+#ifdef HAVE_ANDROID_PROPERTIES
 #include <hybris/properties/properties.h>
+#else
+/* m52xq: no Android properties on a mainline kernel: the device tree model / nothing instead */
+#include <paths.h>
+#ifndef _PATH_MOUNTED
+#define _PATH_MOUNTED "/proc/mounts"	/* came with the hybris headers before */
+#endif
+#include <QFile>
+#define PROP_VALUE_MAX 92
+static void property_get(const char *key, char *value, const char *def)
+{
+    QByteArray v(def);
+    if (!strcmp(key, "ro.product.model") || !strcmp(key, "ro.product.manufacturer")) {
+        QFile f(QStringLiteral("/proc/device-tree/model"));	/* "Samsung Galaxy M52 5G" */
+        if (f.open(QIODevice::ReadOnly)) {
+            QByteArray m = f.readAll().trimmed();
+            while (m.endsWith('\0'))
+                m.chop(1);
+            int sp = m.indexOf(' ');
+            if (!strcmp(key, "ro.product.manufacturer"))
+                v = sp > 0 ? m.left(sp) : m;
+            else
+                v = sp > 0 ? m.mid(sp + 1) : QByteArray();
+        }
+    }
+    qstrncpy(value, v.constData(), PROP_VALUE_MAX);
+}
+#endif
 #include <QDBusReply>
 
