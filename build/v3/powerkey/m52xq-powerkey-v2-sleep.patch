+		out = subprocess.run(['su', USER, '-s', '/bin/sh', '-c', 'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus '
+				'gsettings get com.lomiri.touch.system activity-timeout; DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus '
+				'gsettings get com.lomiri.touch.system dim-timeout'], capture_output=True, text=True, timeout=10).stdout.split()
+		gs = tuple(int(v) for v in out if v.isdigit())
+	except (subprocess.SubprocessError, OSError, ValueError):
+		return True
+	if len(gs) == 2 and gs != idle['gs']:
+		idle['gs'] = gs
+		idle['off_t'], idle['dim_t'] = gs
+		log('inactivity: screen off after %d s, dim after %d s (0 = never)' % gs)
+	return True
+
