+/* m52xq r93 (Lomiri): with the libm52xq-wl-scale1.so shim the window runs at scale 1 (logical unit = pixel, the only
+ * way Mir delivers touches and sizes consistently). M52XQ_UI_SCALE (the wrapper sets 2.625 = the Lomiri grid unit / 8)
+ * then enlarges the UI itself: icon and picture sizes, size requests, margins, spacing, font DPI and the CSS sizes. */
+static double m52xq_ui_scale = 1.0;	/* declared above */
+static int m52xq_px(int v) { return v > 0 ? (int)(v * m52xq_ui_scale + 0.5) : v; }
+
+static void
+m52xq_scale_widget(GtkWidget *w)
+{
+        int a, b;
+        gtk_widget_get_size_request(w, &a, &b);
+        if (a > 0 || b > 0)
+                gtk_widget_set_size_request(w, m52xq_px(a), m52xq_px(b));
+        gtk_widget_set_margin_start(w, m52xq_px(gtk_widget_get_margin_start(w)));
+        gtk_widget_set_margin_end(w, m52xq_px(gtk_widget_get_margin_end(w)));
+        gtk_widget_set_margin_top(w, m52xq_px(gtk_widget_get_margin_top(w)));
+        gtk_widget_set_margin_bottom(w, m52xq_px(gtk_widget_get_margin_bottom(w)));
+        if (GTK_IS_IMAGE(w) && gtk_image_get_pixel_size(GTK_IMAGE(w)) > 0)
+                gtk_image_set_pixel_size(GTK_IMAGE(w), m52xq_px(gtk_image_get_pixel_size(GTK_IMAGE(w))));
+        if (GTK_IS_BOX(w))
+                gtk_box_set_spacing(GTK_BOX(w), m52xq_px(gtk_box_get_spacing(GTK_BOX(w))));
+        if (GTK_IS_GRID(w)) {
+                gtk_grid_set_row_spacing(GTK_GRID(w), m52xq_px(gtk_grid_get_row_spacing(GTK_GRID(w))));
+                gtk_grid_set_column_spacing(GTK_GRID(w), m52xq_px(gtk_grid_get_column_spacing(GTK_GRID(w))));
+        }
+        for (GtkWidget *c = gtk_widget_get_first_child(w); c; c = gtk_widget_get_next_sibling(c))
+                m52xq_scale_widget(c);
+}
