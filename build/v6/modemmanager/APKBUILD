	polkit-dev
	vala
	"
checkdepends="glib-dev py3-gobject3 py3-dbus"
subpackages="
	$pkgname-lang
	$pkgname-doc
	libmm-glib:libmm
	$pkgname-dbg
	$pkgname-dev
