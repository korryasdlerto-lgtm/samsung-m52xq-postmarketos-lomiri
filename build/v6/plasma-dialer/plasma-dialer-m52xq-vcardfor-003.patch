+
+QByteArray ContactController::vcardFor(const QString &name, const QString &number)
+{
+    KContacts::Addressee a;
+    const QString n = name.trimmed();
+    a.setFormattedName(n);
+    a.setGivenName(n);
+    // m52xq 003 в6: the dial pad shows the number formatted ("444-4"); the call history and the contact lookup use the plain
+    // number ("4444"): keep only digits, + * #, otherwise the name never showed in the call history
+    QString num;
+    for (const QChar c : number)
+        if (c.isDigit() || c == QLatin1Char('+') || c == QLatin1Char('*') || c == QLatin1Char('#'))
+            num.append(c);
+    if (!num.isEmpty()) {
+        KContacts::PhoneNumber pn(num);
+        pn.setType(KContacts::PhoneNumber::Cell);
+        a.insertPhoneNumber(pn);
+    }
+    return KContacts::VCardConverter().createVCard(a);
+}
