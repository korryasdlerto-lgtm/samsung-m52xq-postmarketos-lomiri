# убунтутач24/003: Alpine ships the D-Bus activation file of org.freedesktop.Telepathy.Client.TelephonyServiceIndicator with SystemdService=lomiri-indicator-telephony-service.service but no such systemd user unit:
# dbus-broker then fails every activation ("unknown unit"), e.g. indicator menu items (url-dispatcher) did nothing
[Unit]
Description=org.freedesktop.Telepathy.Client.TelephonyServiceIndicator (D-Bus activated)
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.Telepathy.Client.TelephonyServiceIndicator
ExecStart=/usr/bin/lomiri-telephony-service-indicator
