# UFS storage on this device uses 4096-byte physical sectors, not the
# 512-byte default losetup assumes -- without this, init_functions.sh's
# mount_subpartitions() (losetup -P) computes wrong sub-partition offsets
# on real hardware, causing it to expose the wrong data as pmOS_root.
deviceinfo_rootfs_image_sector_size="4096"
