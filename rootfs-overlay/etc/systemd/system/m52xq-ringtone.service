[Unit]
Description=M52XQ: ringtone and vibration for an incoming modem call
After=ModemManager.service

[Service]
# as the user: PulseAudio of the session refuses another user ("Access denied"); ModemManager (read only) and hfd-service are on the system bus
User=user
Group=user
Environment=XDG_RUNTIME_DIR=/run/user/10000
Environment=PULSE_SERVER=unix:/run/user/10000/pulse/native
ExecStart=/usr/local/bin/m52xq-ringtone
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
