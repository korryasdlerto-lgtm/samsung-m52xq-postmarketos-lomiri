#!/usr/bin/python3
# M52XQ (убунтутач24/003, в4): on-screen keyboard for GTK / text-input-v3 applications (Firefox) under Lomiri.
#
# Mir offers zwp_text_input_manager_v3 to such applications and routes it to zwp_input_method_v2, but the keyboard of Lomiri (maliit-server) is an
# input method of the old kind (Qt text-input v1/v2 + its own D-Bus protocol): nobody was behind v3, Firefox got no keyboard. This bridge is both:
# - a Wayland zwp_input_method_v2 client (the wire protocol is spoken directly, no libraries): activate / deactivate / surrounding_text /
#   content_type events of the focused text field, and commit_string / set_preedit_string / delete_surrounding_text / commit requests back;
# - a Maliit client over the peer-to-peer D-Bus connection of maliit-server (like the Qt input context plugin: activateContext,
#   updateWidgetInformation, showInputMethod / hideInputMethod; the server calls back commitString, updatePreedit, keyEvent on our object).
# So the keyboard is the normal Lomiri one (shown by Lomiri as the input method panel), and what it types goes into the field of Firefox.
import os
import ctypes
import socket
import struct
import sys
import time

import gi
from gi.repository import Gio, GLib

MALIIT_NAME = 'org.maliit.server'
MALIIT_ADDRESS_PATH = '/org/maliit/server/address'
SERVER_PATH = '/com/meego/inputmethod/uiserver1'
SERVER_IFACE = 'com.meego.inputmethod.uiserver1'
CLIENT_PATH = '/com/meego/inputmethod/inputcontext'

CLIENT_XML = '''<node>
  <interface name="com.meego.inputmethod.inputcontext1">
    <method name="activationLostEvent"/>
    <method name="imInitiatedHide"/>
    <method name="commitString"><arg type="s"/><arg type="i"/><arg type="i"/><arg type="i"/></method>
    <method name="updatePreedit"><arg type="s"/><arg type="a(iii)"/><arg type="i"/><arg type="i"/><arg type="i"/></method>
    <method name="keyEvent"><arg type="i"/><arg type="i"/><arg type="i"/><arg type="s"/><arg type="b"/><arg type="i"/><arg type="y"/></method>
    <method name="updateInputMethodArea"><arg type="i"/><arg type="i"/><arg type="i"/><arg type="i"/></method>
    <method name="setGlobalCorrectionEnabled"><arg type="b"/></method>
    <method name="preeditRectangle"><arg type="b" direction="out"/><arg type="i" direction="out"/><arg type="i" direction="out"/><arg type="i" direction="out"/><arg type="i" direction="out"/></method>
    <method name="setRedirectKeys"><arg type="b"/></method>
    <method name="setDetectableAutoRepeat"><arg type="b"/></method>
    <method name="setSelection"><arg type="i"/><arg type="i"/></method>
    <method name="selection"><arg type="b" direction="out"/><arg type="s" direction="out"/></method>
    <method name="setLanguage"><arg type="s"/></method>
    <method name="notifyExtendedAttributeChanged"><arg type="i"/><arg type="s"/><arg type="s"/><arg type="s"/><arg type="v"/></method>
    <method name="pluginSettingsLoaded"><arg type="a(sssia(ssibva{sv}))"/></method>
  </interface>
</node>'''

# Qt key codes the keyboard sends as key events
KEY_BACKSPACE, KEY_RETURN, KEY_ENTER, KEY_DELETE = 0x01000003, 0x01000004, 0x01000005, 0x01000007
EVENT_PRESS = 6
# Qt key -> evdev key code, sent as real key presses through zwp_virtual_keyboard_v1 (Return, arrows, ...)
EVDEV = {0x01000000: 1, 0x01000001: 15, 0x01000004: 28, 0x01000005: 28, 0x01000012: 105, 0x01000013: 103, 0x01000014: 106, 0x01000015: 108,
         0x01000010: 102, 0x01000011: 107, 0x01000016: 104, 0x01000017: 109}

DEBUG = os.environ.get('OSK_BRIDGE_DEBUG') == '1'
HIDE_DELAY_MS = 400


def log(msg):
    print('m52xq-osk-bridge: ' + msg, flush=True)


def dbg(msg):
    if DEBUG:
        log(msg)


def make_keymap():
    """Text of a normal xkb keymap (libxkbcommon through ctypes): the compositor needs one for the virtual keyboard."""
    x = ctypes.CDLL('libxkbcommon.so.0')
    x.xkb_context_new.restype = ctypes.c_void_p
    x.xkb_keymap_new_from_names.restype = ctypes.c_void_p
    x.xkb_keymap_new_from_names.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int]
    x.xkb_keymap_get_as_string.restype = ctypes.c_void_p
    x.xkb_keymap_get_as_string.argtypes = [ctypes.c_void_p, ctypes.c_int]
    ctx = x.xkb_context_new(0)
    km = x.xkb_keymap_new_from_names(ctx, None, 0)
    ptr = x.xkb_keymap_get_as_string(km, 1)
    text = ctypes.string_at(ptr)
    ctypes.CDLL('libc.so.6').free(ctypes.c_void_p(ptr))
    return text


class Wayland:
    """The little of the Wayland wire protocol we need."""

    def __init__(self, on_im_event):
        path = os.path.join(os.environ['XDG_RUNTIME_DIR'], os.environ.get('WAYLAND_DISPLAY', 'wayland-0'))
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.sock.setblocking(False)
        self.buf = b''
        self.next_id = 2
        self.names = {}          # interface -> (name, version)
        self.ids = {}            # object id -> interface
        self.seat = 0
        self.im = 0
        self.serial = 0
        self.on_im_event = on_im_event
        self.registry = self.new_id('wl_registry')
        self.send(1, 1, struct.pack('<I', self.registry))        # wl_display.get_registry
        self.sync = self.new_id('wl_callback')
        self.send(1, 0, struct.pack('<I', self.sync))            # wl_display.sync
        GLib.io_add_watch(self.sock.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.readable)

    def new_id(self, iface):
        i = self.next_id
        self.next_id += 1
        self.ids[i] = iface
        return i

    def send(self, obj, opcode, payload=b''):
        size = 8 + len(payload)
        self.sock.sendall(struct.pack('<II', obj, (size << 16) | opcode) + payload)

    @staticmethod
    def s(text):
        b = text.encode() + b'\0'
        return struct.pack('<I', len(b)) + b + b'\0' * ((4 - len(b) % 4) % 4)

    def bind(self, iface, version):
        name, ver = self.names[iface]
        v = min(version, ver)
        i = self.new_id(iface)
        self.send(self.registry, 0, struct.pack('<I', name) + self.s(iface) + struct.pack('<II', v, i))
        return i

    # --- requests of zwp_input_method_v2
    def commit_string(self, text):
        self.send(self.im, 0, self.s(text))

    def set_preedit(self, text, begin, end):
        self.send(self.im, 1, self.s(text) + struct.pack('<ii', begin, end))

    def delete_surrounding(self, before, after):
        self.send(self.im, 2, struct.pack('<II', before, after))

    def commit(self):
        self.send(self.im, 3, struct.pack('<I', self.serial))

    # --- events
    def readable(self, fd, cond):
        if cond & (GLib.IO_HUP | GLib.IO_ERR):
            log('Wayland connection closed')
            sys.exit(1)
        try:
            data = self.sock.recv(65536)
        except BlockingIOError:
            return True
        if not data:
            log('Wayland connection closed')
            sys.exit(1)
        self.buf += data
        while len(self.buf) >= 8:
            obj, so = struct.unpack_from('<II', self.buf)
            size, opcode = so >> 16, so & 0xffff
            if len(self.buf) < size:
                break
            body = self.buf[8:size]
            self.buf = self.buf[size:]
            self.event(obj, opcode, body)
        return True

    @staticmethod
    def rd_str(body, off):
        n = struct.unpack_from('<I', body, off)[0]
        s = body[off + 4:off + 4 + max(n - 1, 0)].decode(errors='replace')
        return s, off + 4 + ((n + 3) & ~3)

    def event(self, obj, opcode, body):
        iface = self.ids.get(obj, 'wl_display' if obj == 1 else '?')
        if iface == 'wl_display':
            if opcode == 0:
                oid, code = struct.unpack_from('<II', body)
                msg, _ = self.rd_str(body, 8)
                log('Wayland error on object %d code %d: %s' % (oid, code, msg))
        elif iface == 'wl_registry' and opcode == 0:
            name, = struct.unpack_from('<I', body)
            iface_name, off = self.rd_str(body, 4)
            ver, = struct.unpack_from('<I', body, off)
            self.names[iface_name] = (name, ver)
        elif iface == 'wl_callback' and opcode == 0 and obj == self.sync:
            self.registry_done()
        elif iface == 'zwp_input_method_v2':
            self.input_method_event(opcode, body)

    def registry_done(self):
        for need in ('wl_seat', 'zwp_input_method_manager_v2'):
            if need not in self.names:
                log('compositor has no ' + need)
                sys.exit(2)
        self.seat = self.bind('wl_seat', 1)
        self.vk = 0
        if 'zwp_virtual_keyboard_manager_v1' in self.names:
            try:
                self.setup_virtual_keyboard()
            except Exception as e:
                log('virtual keyboard unavailable: %r' % (e,))
                self.vk = 0
        mgr = self.bind('zwp_input_method_manager_v2', 1)
        self.im = self.new_id('zwp_input_method_v2')
        self.send(mgr, 0, struct.pack('<II', self.seat, self.im))   # get_input_method(seat, id)
        log('input method v2 registered')

    def setup_virtual_keyboard(self):
        vkm = self.bind('zwp_virtual_keyboard_manager_v1', 1)
        self.vk = self.new_id('zwp_virtual_keyboard_v1')
        self.send(vkm, 0, struct.pack('<II', self.seat, self.vk))          # create_virtual_keyboard(seat, id)
        text = make_keymap() + b'\0'
        fd = os.memfd_create('m52xq-keymap')
        os.write(fd, text)
        size = len(text)
        msg = struct.pack('<II', self.vk, ((8 + 8) << 16) | 0) + struct.pack('<II', 1, size)    # keymap(format xkb_v1, fd, size)
        socket.send_fds(self.sock, [msg], [fd])
        os.close(fd)
        log('virtual keyboard ready (keymap %d bytes)' % size)

    def press(self, evdev_key):
        """A real key press and release (evdev code) of the virtual keyboard."""
        if not self.vk:
            return False
        t = int(time.monotonic() * 1000) & 0xffffffff
        self.send(self.vk, 1, struct.pack('<III', t, evdev_key, 1))
        self.send(self.vk, 1, struct.pack('<III', (t + 5) & 0xffffffff, evdev_key, 0))
        return True

    def input_method_event(self, opcode, body):
        if opcode == 0:
            self.on_im_event('activate')
        elif opcode == 1:
            self.on_im_event('deactivate')
        elif opcode == 2:
            text, off = self.rd_str(body, 0)
            cursor, anchor = struct.unpack_from('<II', body, off)
            self.on_im_event('surrounding', text, cursor, anchor)
        elif opcode == 3:
            self.on_im_event('change_cause', struct.unpack_from('<I', body)[0])
        elif opcode == 4:
            hint, purpose = struct.unpack_from('<II', body)
            self.on_im_event('content_type', hint, purpose)
        elif opcode == 5:
            self.serial += 1
            self.on_im_event('done')
        elif opcode == 6:
            log('input method unavailable: another input method owns the seat')
            self.on_im_event('unavailable')


class Bridge:
    def __init__(self):
        self.pending = {'active': False, 'text': '', 'cursor': 0, 'anchor': 0, 'hint': 0, 'purpose': 0}
        self.active = False
        self.conn = None
        self.shown = False
        self.hide_id = 0
        self.wl = Wayland(self.im_event)
        self.connect_maliit()
        GLib.timeout_add_seconds(10, self.watchdog)

    # ---- Maliit side
    def connect_maliit(self):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            v = bus.call_sync(MALIIT_NAME, MALIIT_ADDRESS_PATH, 'org.freedesktop.DBus.Properties', 'Get',
                              GLib.Variant('(ss)', ('org.maliit.Server.Address', 'address')), None, Gio.DBusCallFlags.NONE, 3000, None)
            addr = v.unpack()[0]
            self.conn = Gio.DBusConnection.new_for_address_sync(addr, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT, None, None)
        except GLib.Error as e:
            log('cannot connect to maliit-server: ' + e.message)
            self.conn = None
            return
        info = Gio.DBusNodeInfo.new_for_xml(CLIENT_XML)
        self.conn.register_object(CLIENT_PATH, info.interfaces[0], self.client_call, None, None)
        self.conn.connect('closed', lambda *a: self.maliit_closed())
        log('connected to maliit-server')

    def maliit_closed(self):
        log('maliit-server connection closed')
        self.conn = None
        self.shown = False

    def watchdog(self):
        if self.conn is None or self.conn.is_closed():
            self.connect_maliit()
            if self.conn and self.active:
                self.show()
        return True

    def server(self, method, args=None):
        if not self.conn:
            return
        try:
            self.conn.call_sync(None, SERVER_PATH, SERVER_IFACE, method, args, None, Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error as e:
            log('%s: %s' % (method, e.message))

    def widget_info(self):
        p = self.pending
        hints = 0
        # content purpose of text-input v3: 0 normal, 1 alpha, 2 digits, 3 number, 4 phone, 5 url, 6 email, 7 name, 8 password, 9 pin, 10 date, 11 time, 12 datetime, 13 terminal
        purpose = p['purpose']
        content = {0: 0, 1: 0, 2: 1, 3: 1, 4: 2, 5: 3, 6: 4}.get(purpose, 0)    # Maliit: free text 0, number 1, phone 2, email 3, custom/url 4
        if purpose == 5:
            content, hints = 3, 0x10             # Qt::ImhUrlCharactersOnly-ish, free enough
        if purpose == 6:
            content, hints = 4, 0x20
        if purpose in (8, 9):
            hints |= 0x1                          # Qt::ImhHiddenText
        d = {
            'focusState': GLib.Variant('b', self.active),
            'surroundingText': GLib.Variant('s', p['text']),
            'cursorPosition': GLib.Variant('i', len(p['text'][:p['cursor']].encode().decode('utf-8', 'ignore'))),
            'anchorPosition': GLib.Variant('i', len(p['text'][:p['anchor']].encode().decode('utf-8', 'ignore'))),
            'contentType': GLib.Variant('i', content),
            'autocapitalizationEnabled': GLib.Variant('b', True),
            'hiddenText': GLib.Variant('b', purpose in (8, 9)),
            'predictionEnabled': GLib.Variant('b', purpose not in (5, 6, 8, 9)),
            'maliit-inputmethod-hints': GLib.Variant('i', hints),
            'enterKeyType': GLib.Variant('i', 0),
            'hasSelection': GLib.Variant('b', p['cursor'] != p['anchor']),
            'winId': GLib.Variant('t', 1),
            'toolbarId': GLib.Variant('i', 0),
        }
        return GLib.Variant('(a{sv}b)', (d, True))

    def show(self):
        self.server('activateContext')
        self.server('updateWidgetInformation', self.widget_info())
        self.server('showInputMethod')
        self.shown = True
        dbg('keyboard shown')

    def hide(self):
        self.server('updateWidgetInformation', self.widget_info())
        self.server('hideInputMethod')
        self.shown = False
        dbg('keyboard hidden')

    # ---- Wayland side
    def im_event(self, kind, *a):
        p = self.pending
        dbg('im %s %s' % (kind, a))
        if kind == 'activate':
            p['active'] = True
        elif kind == 'deactivate':
            p['active'] = False
        elif kind == 'surrounding':
            p['text'], p['cursor'], p['anchor'] = a
        elif kind == 'content_type':
            p['hint'], p['purpose'] = a
        elif kind == 'done':
            was = self.active
            self.active = p['active']
            if self.active:
                # Firefox flips active / inactive / active within ~100 ms on one tap: a pending hide is dropped and the keyboard,
                # if it is already up, only gets the new field state
                if self.hide_id:
                    GLib.source_remove(self.hide_id)
                    self.hide_id = 0
                if not self.shown:
                    self.show()
                else:
                    self.server('updateWidgetInformation', self.widget_info())
            elif was and not self.hide_id:
                self.hide_id = GLib.timeout_add(HIDE_DELAY_MS, self.delayed_hide)

    def delayed_hide(self):
        self.hide_id = 0
        if not self.active:
            self.hide()
        return False

    # ---- calls of maliit-server on our object
    def client_call(self, conn, sender, path, iface, method, params, inv):
        try:
            self.client_method(method, params.unpack(), inv)
        except Exception as e:      # never let one bad call kill the bridge
            log('%s failed: %r' % (method, e))
            inv.return_value(None)

    def client_method(self, method, a, inv):
        dbg('maliit -> %s %s' % (method, a))
        if method == 'commitString':
            text, rep_start, rep_len, cursor = a
            if rep_len > 0 or rep_start != 0:
                before = max(-rep_start, 0) if rep_start < 0 else 0
                after = rep_len + min(rep_start, 0) if rep_len else 0
                if before or after:
                    self.wl.delete_surrounding(before, max(after, 0))
            self.wl.set_preedit('', 0, 0)
            self.wl.commit_string(text)
            self.wl.commit()
            inv.return_value(None)
        elif method == 'updatePreedit':
            text, fmts, rep_start, rep_len, cursor = a
            n = len(text.encode())
            self.wl.set_preedit(text, n, n)
            self.wl.commit()
            inv.return_value(None)
        elif method == 'keyEvent':
            typ, key, mods, text, auto, count, req = a
            if typ == EVENT_PRESS or True:
                self.key(typ, key, text)
            inv.return_value(None)
        elif method == 'preeditRectangle':
            inv.return_value(GLib.Variant('(biiii)', (False, 0, 0, 0, 0)))
        elif method == 'selection':
            inv.return_value(GLib.Variant('(bs)', (False, '')))
        elif method == 'imInitiatedHide':
            # the user closed the keyboard by itself: nothing to do for Wayland
            self.shown = False
            inv.return_value(None)
        else:
            inv.return_value(None)

    def key(self, typ, key, text):
        if typ != EVENT_PRESS:
            return
        if key == KEY_BACKSPACE:
            self.wl.delete_surrounding(1, 0)
            self.wl.commit()
        elif key in EVDEV and self.wl.press(EVDEV[key]):
            pass
        elif key in (KEY_RETURN, KEY_ENTER):
            self.wl.commit_string('\n')
            self.wl.commit()
        elif key == KEY_DELETE:
            self.wl.delete_surrounding(0, 1)
            self.wl.commit()
        elif text:
            self.wl.commit_string(text)
            self.wl.commit()


def main():
    if 'XDG_RUNTIME_DIR' not in os.environ:
        os.environ['XDG_RUNTIME_DIR'] = '/run/user/10000'
    if 'DBUS_SESSION_BUS_ADDRESS' not in os.environ:
        os.environ['DBUS_SESSION_BUS_ADDRESS'] = 'unix:path=/run/user/10000/bus'
    Bridge()
    GLib.MainLoop().run()


main()
