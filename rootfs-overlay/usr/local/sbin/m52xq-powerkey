#!/usr/bin/python3
# M52XQ (убунтутач24/003, Lomiri): what repowerd does on Ubuntu Touch, as far as this image needs it.
# 1) Short press of the power key: repowerd gets the key from unity-system-compositor, which this image does not have,
#    so a short press did nothing (Lomiri itself only handles the long press: its power dialog). Screen on -> Lomiri lock
#    screen (org.gnome.ScreenSaver.Lock) + backlight 0 + touchscreen inhibited (no touches in the pocket); screen off ->
#    backlight back + touchscreen on (the lock screen is there, unlock by swipe). Longer presses are left to Lomiri.
# 2) com.canonical.Unity.Screen DisplayPowerStateChange(status, reason) on the system bus: qtmir runs its orientation
#    sensor only after "display on" from it, so the screen never rotated (one reading at start, then nothing). Sent at
#    start, every 15 s while the screen is on (Lomiri restarts) and on every screen on / off.
# 4) com.lomiri.Repowerd (the part of repowerd the shade uses): the brightness slider of ayatana-indicator-power calls
#    getBrightnessParams / setUserBrightness there, nothing answered (slider without effect); "Adjust brightness
#    automatically" = userAutobrightnessEnable: the ambient light of iio-sensor-proxy (claimed while it is on) sets the
#    backlight, the slider value is the user's level for "normal" light. The wakelock calls only get cookies.
# 3) Rotation: qtmir creates its QOrientationSensor in the Mir thread, which gets no D-Bus signals: start() reads the
#    orientation once (synchronously), the later PropertiesChanged of iio-sensor-proxy never arrive. We watch
#    iio-sensor-proxy ourselves and on every new AccelerometerOrientation send "display off, display on": qtmir stops and
#    starts its sensor and reads the new orientation.
# 5) v2 (26.10): inactivity and system sleep, which PowerDevil did in the Plasma image (all night not one suspend,
#    8 %/h, the screen never went off by itself). Touches / keys are activity; after dim-timeout the backlight dims,
#    after activity-timeout (com.lomiri.touch.system, "Lock phone when idle" in Settings; 0 = never) lock + screen off.
#    keepDisplayOn ("Keep screen on" in the shade, players) holds the screen on until removeDisplayOnRequest or until
#    its client is gone. Screen off for SLEEP_AFTER s, no requestSysState, no call, no sound -> systemctl suspend. After
#    a resume: a wake-up by Wi-Fi / mobile data stays dark (system-sleep/m52xq-wifi-dark.sh suspends again), any other
#    (power key, call, SMS) turns the screen on.
import glob, math, os, struct, subprocess, threading, time
from gi.repository import Gio, GLib

SHORT = 1.0	# s
BL = glob.glob('/sys/class/backlight/*/brightness')[0]
SAVED = '/run/m52xq-powerkey.brightness'
USER = 'user'
NAME, PATH, IFACE = 'com.canonical.Unity.Screen', '/com/canonical/Unity/Screen', 'com.canonical.Unity.Screen'
bus = None
SLEEP_AFTER = 10	# s of screen off before the suspend
# 003 в7 (2026-11-10): a Telegram call in the sleep woke the phone over Wi-Fi (00:39:51), but after a sleep of more than ~75 s
# Telegram Desktop has to reconnect to its server and set the call up: 20 s were not enough, the phone slept again and the call was
# missed (the missed-call notice came at the next wake-up). With Telegram running a Wi-Fi wake-up keeps the phone awake for 45 s.
TG_GRACE = 45
# 003 в7: m52xq-voip-audio refreshes this file every second while Telegram plays (ringing or a call). While it is fresh the phone does
# not suspend and Lomiri's notification "off" (reason 4) does not blank the screen: at 00:45:47 it did, 5 s into the ring, and the
# phone slept 10 s later with the call still ringing.
VOIP_FLAG = '/run/user/10000/m52xq-voip-active'


def voip_active():
	try:
		return time.time() - os.stat(VOIP_FLAG).st_mtime < 5
	except OSError:
		return False


def telegram_running():
	for pid in os.listdir('/proc'):
		if pid.isdigit():
			try:
				# the process is "Telegram --" (comm "Telegram"), not telegram-desktop (00:45: the 45 s were not used)
				if open('/proc/%s/comm' % pid).read().strip() == 'Telegram':
					return True
			except OSError:
				pass
	return False


RESUME_GRACE = 20	# s after a resume (a dark wake-up: the apps get what the wake-up brought, then this suspends again; m52xq-wifi-dark only watches the keys)
DIM_LEVEL = 0.3	# of the brightness
OFF_DELAY = 2500	# ms between backlight off and "display off" to Lomiri
TOUCH = 'Synaptics TCM Oncell Touchscreen'
idle = {'last': time.monotonic(), 'dimmed': False, 'off_since': None, 'dim_t': 45, 'off_t': 60, 'gs': None,
	'keep': {}, 'sys': {}, 'resumed': 0.0, 'next_try': 0.0, 'key_ignore': 0.0}


def log(msg):
	print('m52xq-powerkey: ' + msg, flush=True)


def find(name):
	for d in glob.glob('/sys/class/input/input*'):
		try:
			if open(d + '/name').read().strip() == name:
				return d
		except OSError:
			pass
	return None


def write(path, value):
	try:
		with open(path, 'w') as f:
			f.write(str(value))
	except OSError as e:
		log('%s: %s' % (path, e))


def screen_is_on():
	return open(BL).read().strip() != '0'


# reasons of the Lomiri Powerd plugin: 0 Unknown, 1 Inactivity, 2 PowerKey, 3 Proximity (on "off" Lomiri shows the lock
# screen unless the reason is Proximity)
INACTIVITY, POWERKEY, PROXIMITY = 1, 2, 3


def power_state(on, reason=POWERKEY):
	def emit():
		bus.emit_signal(None, PATH, IFACE, 'DisplayPowerStateChange', GLib.Variant('(ii)', (1 if on else 0, reason)))
		return False
	GLib.idle_add(emit)


def lock():
	uid = subprocess.run(['id', '-u', USER], capture_output=True, text=True).stdout.strip()
	env = 'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%s/bus' % uid
	subprocess.run(['su', USER, '-s', '/bin/sh', '-c', env + ' gdbus call --session -d org.gnome.ScreenSaver'
			' -o /org/gnome/ScreenSaver -m org.gnome.ScreenSaver.Lock'],
		stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)


def screen_off(touch, reason=POWERKEY):
	b = open(BL).read().strip()
	if b != '0' and not idle['dimmed']:	# dimmed: SAVED still has the real level
		write(SAVED, b)
	# v4: first the backlight (the screen goes dark at once, like on Ubuntu Touch), then the lock in the dark: Lomiri draws its lock screen
	# while the display is off ("display off" reaches it OFF_DELAY later, so it keeps drawing until then). The old order (lock, 0.3 s, backlight)
	# showed the lock screen for a moment before the screen went off.
	write(BL, 0)
	if touch:
		write(touch + '/inhibited', 1)
	lock()
	idle['dimmed'] = False
	idle['off_since'] = time.monotonic()
	# v2: Lomiri stops drawing on "display off" and loaded / drew its lock screen only after the next "on" (an empty
	# wallpaper for ~3 s, then the lock screen): the backlight is off now, Lomiri hears it once the lock screen is drawn
	GLib.timeout_add(OFF_DELAY, lambda: (not screen_is_on() and power_state(False, reason)) and False)
	log('screen off (brightness %s, reason %d)' % (b, reason))


def saved_level():
	try:
		return open(SAVED).read().strip() or '180'
	except OSError:
		return '180'


DARK_RESUME = '/sys/module/panel_samsung_s6e3hab_amb667an01/parameters/dark_resume'


def dark_resume_active():
	try:
		return int(open(DARK_RESUME).read().strip() or 0) > 0
	except (OSError, ValueError):
		return False


def screen_on(touch, reason=POWERKEY):
	if touch:
		write(touch + '/inhibited', 0)
	b = saved_level()
	power_state(True, reason)
	time.sleep(0.25)	# a fresh frame before the backlight, not the last one from before the screen went off
	write(BL, b)
	emit_brightness()
	idle['last'] = time.monotonic()
	idle['dimmed'] = False
	idle['off_since'] = None
	sensors_claim()
	log('screen on (brightness %s)' % b)


def keys():
	key = find('pmic_pwrkey')
	dev = '/dev/input/' + os.path.basename(glob.glob(key + '/event*')[0])
	log('%s, backlight %s' % (dev, BL))
	fmt = 'llHHi'
	size = struct.calcsize(fmt)
	down = None
	with open(dev, 'rb') as f:
		while True:
			sec, usec, typ, code, value = struct.unpack(fmt, f.read(size))
			if typ != 1 or code != 116:	# EV_KEY, KEY_POWER
				continue
			t = sec + usec / 1e6
			log('KEY_POWER event value=%d (evdev time %.3f, monotonic %.3f, screen on: %s)' % (value, t, time.monotonic(), screen_is_on()))
			if value == 1:
				down = t
			elif value == 0 and down is not None:
				held, down = t - down, None
				if held >= SHORT:
					continue
				touch = find(TOUCH)
				# the press that woke the system: the resume has already turned the screen on
				if time.monotonic() < idle['key_ignore'] and screen_is_on():
					log('power key of the wake-up, screen stays on')
					continue
				if screen_is_on():
					screen_off(touch)
				else:
					screen_on(touch)


def reorient():
	def emit():
		# reason Proximity: Lomiri must not lock the screen for this off/on (it did on every rotation)
		bus.emit_signal(None, PATH, IFACE, 'DisplayPowerStateChange', GLib.Variant('(ii)', (0, PROXIMITY)))
		GLib.timeout_add(50, lambda: bus.emit_signal(None, PATH, IFACE, 'DisplayPowerStateChange',
			GLib.Variant('(ii)', (1, PROXIMITY))) and False)
		return False
	GLib.idle_add(emit)


REPOWERD, REPOWERD_PATH = 'com.lomiri.Repowerd', '/com/lomiri/Repowerd'
REPOWERD_XML = """<node><interface name="com.lomiri.Repowerd">
<property name="brightness" type="i" access="readwrite"/>
<method name="requestSysState"><arg type="s" direction="in"/><arg type="i" direction="in"/><arg type="s" direction="out"/></method>
<method name="clearSysState"><arg type="s" direction="in"/></method>
<method name="requestWakeup"><arg type="s" direction="in"/><arg type="t" direction="in"/><arg type="s" direction="out"/></method>
<method name="clearWakeup"><arg type="s" direction="in"/></method>
<signal name="Wakeup"/>
<method name="enableProximityHandling"><arg type="s" direction="in"/></method>
<method name="disableProximityHandling"><arg type="s" direction="in"/></method>
<method name="registerClient"><arg type="s" direction="in"/></method>
<method name="unregisterClient"><arg type="s" direction="in"/></method>
<method name="ackStateChange"><arg type="i" direction="in"/></method>
<method name="userAutobrightnessEnable"><arg type="b" direction="in"/></method>
<method name="getBrightnessParams"><arg type="(iiiib)" direction="out"/></method>
<method name="setUserBrightness"><arg type="i" direction="in"/></method>
<method name="listSysRequests"><arg type="a(ssi)" direction="out"/></method>
<method name="getSysRequestStats"><arg type="a(ssuttt)" direction="out"/></method>
<signal name="SysPowerStateChange"><arg type="i"/></signal>
<signal name="Wakeup"/>
</interface></node>"""
# the brightness itself is set by the indicator through com.canonical.Unity.Screen (repowerd's screen interface),
# which had only its signal here ("Unable to call uscreen.setBrightness: Object does not exist")
USCREEN_XML = """<node><interface name="com.canonical.Unity.Screen">
<method name="setUserBrightness"><arg type="i" direction="in"/></method>
<method name="userAutobrightnessEnable"><arg type="b" direction="in"/></method>
<method name="setScreenPowerMode"><arg type="s" direction="in"/><arg type="i" direction="in"/><arg type="b" direction="out"/></method>
<method name="keepDisplayOn"><arg type="i" direction="out"/></method>
<method name="removeDisplayOnRequest"><arg type="i" direction="in"/></method>
<method name="setInactivityTimeouts"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="setTouchVisualizationEnabled"><arg type="b" direction="in"/></method>
<method name="m52xqRefresh"/>
<signal name="DisplayPowerStateChange"><arg type="i"/><arg type="i"/></signal>
</interface></node>"""
NOTIF_REASONS = (4, 5)	# Lomiri Powerd reasons: Notification, SnapDecision
BR_MIN, BR_MAX, BR_DEFAULT = 5, 255, 180
bright = {'user': BR_DEFAULT, 'auto': False, 'lux': None, 'llux': None, 'target': None, 'cookie': 0, 'user_t': 0.0}


def saved_brightness():
	try:
		return int(open(SAVED).read().strip() or BR_DEFAULT)
	except (OSError, ValueError):
		return BR_DEFAULT


def set_backlight(b):
	b = max(BR_MIN, min(BR_MAX, int(b)))
	write(SAVED, b)	# what screen_on() restores
	if screen_is_on():
		write(BL, b)
		# not while the finger is on the slider: with auto brightness the level differs from the slider value
		if time.monotonic() - bright['user_t'] > 3:
			emit_brightness(b)


def current_brightness():
	try:
		return max(BR_MIN, min(BR_MAX, int(saved_level())))
	except ValueError:
		return bright['user']


# v2: the shade slider follows the Repowerd "brightness" property (notify::brightness of its proxy); without
# PropertiesChanged it never got a value (the schema key only changes when the slider itself moves): always at the minimum
def emit_brightness(b=None):
	def emit():
		bus.emit_signal(None, REPOWERD_PATH, 'org.freedesktop.DBus.Properties', 'PropertiesChanged',
			GLib.Variant('(sa{sv}as)', (REPOWERD, {'brightness': GLib.Variant('i', current_brightness() if b is None else b)}, [])))
		return False
	GLib.idle_add(emit)


def auto_target():
	# the user's level is the brightness at ~50 lux (a room), scaled with the log of the light
	factor = 0.35 + 0.35 * bright['llux']	# 0 lux 0.35, 10 lux 0.71, 50 lux 0.95, 1000 lux 1.4, 10000 lux 1.75
	return max(BR_MIN + 5, min(BR_MAX, bright['user'] * factor))


# v2: the light under the OLED jumps from one reading to the next (1824 -> 18 lux) and the backlight followed every
# second, it never stood still: log of the light averaged over ~5 s, a new target only when it is 10 % away from the
# current one, and once there the backlight stays
def auto_step(force=False):
	if not bright['auto'] or bright['lux'] is None or not screen_is_on() or idle['dimmed']:
		return True
	l = math.log10(1 + max(0.0, bright['lux']))
	bright['llux'] = l if bright['llux'] is None else bright['llux'] + 0.2 * (l - bright['llux'])
	cand = auto_target()
	t = bright['target']
	if force or t is None or abs(cand - t) > max(8, 0.1 * t):
		bright['target'] = t = cand
	cur = int(open(BL).read().strip() or 0)
	diff = t - cur
	if abs(diff) >= 2:
		set_backlight(cur + (diff if abs(diff) < 6 else diff * 0.25))
	return True


def claim_light():
	try:
		bus.call_sync('net.hadess.SensorProxy', '/net/hadess/SensorProxy', 'net.hadess.SensorProxy',
			'ClaimLight' if bright['auto'] else 'ReleaseLight', None, None, Gio.DBusCallFlags.NONE, 5000, None)
		log('light sensor ' + ('claimed' if bright['auto'] else 'released'))
		if bright['auto']:	# v2: the level now, not only from the next PropertiesChanged
			v = bus.call_sync('net.hadess.SensorProxy', '/net/hadess/SensorProxy', 'org.freedesktop.DBus.Properties',
				'Get', GLib.Variant('(ss)', ('net.hadess.SensorProxy', 'LightLevel')), None, Gio.DBusCallFlags.NONE,
				2000, None)
			bright['lux'] = v.unpack()[0]
	except GLib.Error as e:
		log('Claim/ReleaseLight: ' + e.message)


def repowerd_call(conn, sender, path, iface, method, params, inv):
	if method in ('setUserBrightness', 'userAutobrightnessEnable'):
		log('%s %s' % (method, params.unpack()[0]))
	elif method not in ('getBrightnessParams', 'listSysRequests', 'getSysRequestStats'):
		log('%s%s from %s' % (method, params.unpack() if params else '()', sender))
	if method == 'getBrightnessParams':
		inv.return_value(GLib.Variant('((iiiib))', ((10, BR_MIN, BR_MAX, BR_DEFAULT, True),)))
		GLib.timeout_add(500, lambda: emit_brightness() and False)	# the indicator restores its key, then gets the real level
	elif method == 'setUserBrightness':
		bright['user'] = max(BR_MIN, min(BR_MAX, params.unpack()[0]))
		bright['user_t'] = time.monotonic()
		if bright['auto']:
			auto_step(True)
		else:
			set_backlight(bright['user'])
		inv.return_value(None)
	elif method == 'userAutobrightnessEnable':
		bright['auto'] = bool(params.unpack()[0])
		log('autobrightness ' + ('on' if bright['auto'] else 'off'))
		claim_light()
		if not bright['auto']:
			set_backlight(bright['user'])
		inv.return_value(None)
	elif method == 'keepDisplayOn':
		bright['cookie'] += 1
		idle['keep'][bright['cookie']] = sender
		GLib.idle_add(activity)	# like repowerd: the request turns a dimmed screen back to full
		inv.return_value(GLib.Variant('(i)', (bright['cookie'],)))
	elif method == 'm52xqRefresh':	# test: display off/on to Lomiri (reason Proximity: no lock) makes it lay the windows out again
		reorient()
		inv.return_value(None)
	elif method == 'removeDisplayOnRequest':
		idle['keep'].pop(params.unpack()[0], None)
		idle['last'] = time.monotonic()	# the inactivity timeout starts now
		inv.return_value(None)
	elif method == 'setInactivityTimeouts':
		off_t, dim_t = params.unpack()
		if off_t >= 0:
			idle['off_t'] = off_t
		if dim_t >= 0:
			idle['dim_t'] = dim_t
		inv.return_value(None)
	elif method == 'setScreenPowerMode':
		mode, reason = params.unpack()
		touch = find(TOUCH)
		if mode == 'on' and dark_resume_active() and reason == 5:
			# m52xq 003 в6: an incoming call wakes the phone through the modem (dark resume) and Lomiri asks for the display with its
			# snap decision (reason 5). The request used to be ignored and m52xq-wifi-dark ended the dark window only later, when nobody
			# asked again: the ring played on a black screen until the call ended. A call ends the dark window here and lights the screen.
			write(DARK_RESUME, 0)
			log('setScreenPowerMode on (reason 5, from %s): call during a dark resume, the display goes on' % sender)
			if not screen_is_on():
				idle['notif_on'] = False	# the snap decision closes when the call is answered: its "off" must not blank the call
				threading.Thread(target=screen_on, args=(touch, reason), daemon=True).start()
		elif mode == 'on' and dark_resume_active():
			# m52xq: an SMS notification made Lomiri light the screen 0.5 s after a modem wake-up (backlight flash before the sound);
			# a call ends the dark window itself (m52xq-wifi-dark), a key too (panel driver)
			log('setScreenPowerMode on (reason %s, from %s) ignored: dark resume' % (reason, sender))
		elif mode == 'on' and not screen_is_on():
			idle['notif_on'] = reason in NOTIF_REASONS
			threading.Thread(target=screen_on, args=(touch, reason), daemon=True).start()
		elif mode == 'off' and screen_is_on():
			# Lomiri sends "off" (4 Notification, 5 SnapDecision) when a notification or a dialog such as the Wi-Fi password closes: it only
			# drops its own request. Off only if that request turned the screen on, else the screen locked while in use
			if reason in NOTIF_REASONS and voip_active():
				log('Lomiri: off (reason %s) ignored, a Telegram call is ringing / active' % reason)
			elif reason in NOTIF_REASONS and not idle.pop('notif_on', False):
				log('Lomiri: off (reason %s) ignored, the screen was not turned on by it' % reason)
			else:
				threading.Thread(target=screen_off, args=(touch, reason), daemon=True).start()
		inv.return_value(GLib.Variant('(b)', (True,)))
	elif method == 'requestSysState':
		bright['cookie'] += 1
		cookie = 'm52xq-%d' % bright['cookie']
		idle['sys'][cookie] = (sender, params.unpack()[0])
		inv.return_value(GLib.Variant('(s)', (cookie,)))
	elif method == 'clearSysState':
		idle['sys'].pop(params.unpack()[0], None)
		inv.return_value(None)
	elif method == 'requestWakeup':
		# m52xq в6 (from classic в4): the clock alarm waits for the Wakeup signal at this time (seconds since the epoch); the RTC
		# wakes a sleeping phone (vendor_boot local-v35: pmk8350 RTC enabled)
		bright['cookie'] += 1
		cookie = 'm52xq-%d' % bright['cookie']
		name, when = params.unpack()
		wakeups[cookie] = when
		log('wakeup %s for %s in %d s' % (cookie, name, when - time.time()))
		if len(wakeups) == 1:
			GLib.timeout_add_seconds(1, wakeup_check)
		wakeup_rtc()
		inv.return_value(GLib.Variant('(s)', (cookie,)))
	elif method == 'clearWakeup':
		wakeups.pop(params.unpack()[0], None)
		wakeup_rtc()
		inv.return_value(None)
	elif method == 'listSysRequests':
		inv.return_value(GLib.Variant('(a(ssi))', ([(n, s, 1) for s, n in idle['sys'].values()],)))
	elif method == 'getSysRequestStats':
		inv.return_value(GLib.Variant('(a(ssuttt))', ([],)))
	else:
		inv.return_value(None)


def repowerd_get(conn, sender, path, iface, prop):
	return GLib.Variant('i', current_brightness())


def repowerd_set(conn, sender, path, iface, prop, value):
	bright['user'] = max(BR_MIN, min(BR_MAX, value.unpack()))
	set_backlight(bright['user'])
	return True


def repowerd():
	bright['user'] = saved_brightness()
	node = Gio.DBusNodeInfo.new_for_xml(REPOWERD_XML)
	bus.register_object(REPOWERD_PATH, node.interfaces[0], repowerd_call, repowerd_get, repowerd_set)
	uscreen = Gio.DBusNodeInfo.new_for_xml(USCREEN_XML)
	bus.register_object(PATH, uscreen.interfaces[0], repowerd_call, None, None)
	Gio.bus_own_name_on_connection(bus, REPOWERD, Gio.BusNameOwnerFlags.NONE,
		lambda c, n: log('owns ' + n), lambda c, n: log('lost ' + n))
	GLib.timeout_add_seconds(1, auto_step)


def watch_orientation():
	proxy = 'net.hadess.SensorProxy'
	last = [None]

	def changed(conn, sender, path, iface, signal, params):
		props = params.unpack()[1]
		if 'LightLevel' in props:
			bright['lux'] = props['LightLevel']
		o = props.get('AccelerometerOrientation')
		if o and o != last[0]:
			last[0] = o
			if screen_is_on():
				reorient()
				log('orientation ' + o)

	# v3: claim only once the proxy has found the accelerometer: a claim that comes in right when the proxy appears (before
	# its SSC accelerometer is probed) is counted but never enables the sensor, and every later claim (Lomiri,
	# monitor-sensor) then sees the count above 0: the orientation stayed "undefined" (v2 boot, 25.10)
	def has_accel():
		try:
			v = bus.call_sync(proxy, '/net/hadess/SensorProxy', 'org.freedesktop.DBus.Properties', 'Get',
				GLib.Variant('(ss)', (proxy, 'HasAccelerometer')), None, Gio.DBusCallFlags.NONE, 2000, None)
			return v.unpack()[0]
		except GLib.Error:
			return False

	def claim(*_):
		tries = [0]

		def attempt():
			tries[0] += 1
			if not has_accel():
				return tries[0] < 120	# keep trying every 0.5 s for a minute
			try:
				bus.call_sync(proxy, '/net/hadess/SensorProxy', proxy, 'ClaimAccelerometer', None, None,
					Gio.DBusCallFlags.NONE, 5000, None)
				log('accelerometer claimed')
			except GLib.Error as e:
				log('ClaimAccelerometer: ' + e.message)
			return False
		GLib.timeout_add(500, attempt)
	bus.signal_subscribe(proxy, 'org.freedesktop.DBus.Properties', 'PropertiesChanged', '/net/hadess/SensorProxy',
		None, Gio.DBusSignalFlags.NONE, changed)
	# claim again whenever iio-sensor-proxy (re)starts
	Gio.bus_watch_name_on_connection(bus, proxy, Gio.BusNameWatcherFlags.NONE, claim, None)


def activity():
	idle['last'] = time.monotonic()
	if idle['dimmed'] and screen_is_on():
		idle['dimmed'] = False
		write(BL, saved_level())
	return False


def watch_activity():
	# the touchscreen (inhibited while the screen is off) and the volume keys; the power key is keys()
	def reader(name):
		while True:
			d = find(name)
			ev = glob.glob(d + '/event*') if d else []
			if not ev:
				time.sleep(5)
				continue
			try:
				with open('/dev/input/' + os.path.basename(ev[0]), 'rb') as f:
					log('activity from %s' % name)
					last = 0.0
					while f.read(24):
						t = time.monotonic()
						if t - last > 1:	# one wake of the main loop per second is enough
							last = t
							GLib.idle_add(activity)
			except OSError as e:
				log('%s: %s' % (name, e))
				time.sleep(5)
	for name in (TOUCH, 'gpio-keys'):
		threading.Thread(target=reader, args=(name,), daemon=True).start()


def read_timeouts():
	# com.lomiri.touch.system of the user (lomiri-system-settings / the shade write it); only a change overrides
	# setInactivityTimeouts; v2: auto-brightness too (after a restart of this service it was off until toggled in the shade)
	env = 'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus'
	cmd = '; '.join('%s gsettings get com.lomiri.touch.system %s' % (env, k)
		for k in ('activity-timeout', 'dim-timeout', 'auto-brightness'))
	try:
		out = subprocess.run(['su', USER, '-s', '/bin/sh', '-c', cmd], capture_output=True, text=True,
			timeout=10).stdout.split()
	except (subprocess.SubprocessError, OSError):
		return True
	gs = tuple(int(v) for v in out if v.isdigit())
	if len(gs) == 2 and gs != idle['gs']:
		idle['gs'] = gs
		idle['off_t'], idle['dim_t'] = gs
		log('inactivity: screen off after %d s, dim after %d s (0 = never)' % gs)
	if out and out[-1] in ('true', 'false') and (out[-1] == 'true') != idle.get('auto_gs'):
		idle['auto_gs'] = out[-1] == 'true'
		if idle['auto_gs'] != bright['auto']:
			bright['auto'] = idle['auto_gs']
			log('autobrightness %s (settings)' % ('on' if bright['auto'] else 'off'))
			claim_light()
			if not bright['auto']:
				set_backlight(bright['user'])
	return True


def watch_settings():
	# v4: the settings used to be polled with `su user gsettings get` every 60 s (a process, a PAM session and a wake of the CPU a minute);
	# now one long-living `gsettings monitor` of the user prints a line on every change, and only then the three keys are read again
	state = {'proc': None, 'timer': 0}

	def changed(*_):
		state['timer'] = 0
		read_timeouts()
		return False

	def readable(fd, cond):
		try:
			data = os.read(fd, 4096)
		except OSError:
			data = b''
		if not data:
			state['proc'] = None
			log('gsettings monitor ended, restarted in 30 s')
			GLib.timeout_add_seconds(30, start)
			return False
		if not state['timer']:
			state['timer'] = GLib.timeout_add(700, changed)	# several keys change together: read once
		return True

	def start():
		try:
			p = subprocess.Popen(['runuser', '-u', USER, '--', 'env', 'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/10000/bus',
				'gsettings', 'monitor', 'com.lomiri.touch.system'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
		except OSError as e:
			log('gsettings monitor: %s' % e)
			return True
		state['proc'] = p
		GLib.io_add_watch(p.stdout.fileno(), GLib.IO_IN | GLib.IO_HUP, readable)
		return False
	start()


def in_call():
	try:
		v = bus.call_sync('org.freedesktop.ModemManager1', '/org/freedesktop/ModemManager1',
			'org.freedesktop.DBus.ObjectManager', 'GetManagedObjects', None, None, Gio.DBusCallFlags.NONE, 3000, None)
	except GLib.Error:
		return False
	for path, ifaces in v.unpack()[0].items():
		call = ifaces.get('org.freedesktop.ModemManager1.Call')
		if call and call.get('State') not in (None, 7):	# 7 = terminated
			return True
	return False


wakeups = {}
WAKEALARM = '/sys/class/rtc/rtc0/wakealarm'


def wakeup_rtc():
	# relative ("+N"): the PMIC RTC counts from its own zero (1970 here), only the distance to the alarm matters
	try:
		with open(WAKEALARM, 'w') as f:
			f.write('0')
		if wakeups:
			with open(WAKEALARM, 'w') as f:
				f.write('+%d' % max(2, int(min(wakeups.values()) - time.time())))
	except OSError as e:
		log('wakealarm: %s' % e)


def wakeup_check():
	now = time.time()
	due = [c for c, t in wakeups.items() if t <= now]
	for c in due:
		del wakeups[c]
	if due:
		log('wakeup %s now' % ' '.join(due))
		bus.emit_signal(None, REPOWERD_PATH, REPOWERD, 'Wakeup', None)
		wakeup_rtc()
	return bool(wakeups)


def sound_running():
	for f in glob.glob('/proc/asound/card*/pcm*/sub*/status'):
		try:
			if 'RUNNING' in open(f).read():
				return True
		except OSError:
			pass
	return bluetooth_sound()


def bluetooth_sound():
	# m52xq в6 (from classic в5): Bluetooth audio does not pass the ALSA card: the phone went to sleep 10 s after the lock and the
	# speaker dropped
	try:
		r = subprocess.run(['runuser', '-u', USER, '--', 'env', 'PULSE_SERVER=unix:/run/user/10000/pulse/native',
			'PULSE_COOKIE=/home/user/.config/pulse/cookie', 'pactl', 'list', 'short', 'sinks'],
			capture_output=True, text=True, timeout=4)
	except (OSError, subprocess.SubprocessError):
		return False
	return any('bluez' in l and 'RUNNING' in l for l in r.stdout.splitlines())


def on_charger():
	# like PowerDevil's "on AC power" profile (the Plasma image did not sleep while the USB cable was in): no automatic suspend
	# while any mains / USB source is online; the screen still goes off by the timeouts, the power key still works
	for d in glob.glob('/sys/class/power_supply/*'):
		try:
			if open(d + '/type').read().strip() in ('Mains', 'USB', 'USB_PD', 'USB_DCP', 'USB_CDP', 'USB_ACA') \
					and open(d + '/online').read().strip() == '1':
				return os.path.basename(d)
		except OSError:
			pass
	return None


def why_awake():
	c = on_charger()
	if c:
		return 'charger ' + c
	# v4: a requestSysState 'active' of the shell (qtmir "Wakelock acquired") stayed held after the screen went off, with no application
	# running (nothing on Wayland but Lomiri and maliit), and the phone never slept. Sound and calls are checked below on their own:
	# the request is only logged now (once per change), it no longer blocks the suspend.
	if idle['sys']:
		key = ','.join(sorted('%s:%s' % (s, n) for s, n in idle['sys'].values()))
		if key != idle.get('sys_logged'):
			idle['sys_logged'] = key
			log('sys-state requests ignored for the suspend: ' + key)
	if voip_active():
		return 'telegram call'
	if in_call():
		return 'call'
	if sound_running():
		return 'sound'
	return None


SENSORS = {'released': False}
SENSOR_PROXY = 'net.hadess.SensorProxy'


def sensors_release():
	# m52xq: the ADSP never went to sleep over the night (qcom_stats adsp Count 0): the accelerometer / light sensor claimed through
	# iio-sensor-proxy keep the SSC running while the phone sleeps. Released right before the suspend, claimed again at the next screen on.
	if SENSORS['released']:
		return
	for m in ('ReleaseAccelerometer', 'ReleaseLight'):
		try:
			bus.call_sync(SENSOR_PROXY, '/net/hadess/SensorProxy', SENSOR_PROXY, m, None, None, Gio.DBusCallFlags.NONE, 3000, None)
		except GLib.Error as e:
			log('%s: %s' % (m, e.message))
	SENSORS['released'] = True
	log('sensors released for the sleep')


def sensors_claim():
	if not SENSORS['released']:
		return
	SENSORS['released'] = False
	try:
		bus.call_sync(SENSOR_PROXY, '/net/hadess/SensorProxy', SENSOR_PROXY, 'ClaimAccelerometer', None, None, Gio.DBusCallFlags.NONE, 3000, None)
	except GLib.Error as e:
		log('ClaimAccelerometer: ' + e.message)
	if bright['auto']:
		claim_light()
	log('sensors claimed again')


def suspend():
	sensors_release()
	r = subprocess.run(['systemctl', 'suspend'], capture_output=True, text=True)
	log('systemctl suspend: %s' % ('ok' if r.returncode == 0 else r.stderr.strip()))


def tick():
	now = time.monotonic()
	if screen_is_on():
		if idle['off_since'] is not None:	# on again by someone else (end of a call: proximity script)
			idle['off_since'] = None
			idle['last'] = now
		t = now - idle['last']
		dim_due = idle['dim_t'] and not idle['dimmed'] and t >= idle['dim_t']
		off_due = idle['off_t'] and t >= idle['off_t']
		if not (dim_due or off_due) or idle['keep'] or in_call():
			return True
		if dim_due and (not idle['off_t'] or idle['dim_t'] < idle['off_t']):
			idle['dimmed'] = True
			write(BL, max(BR_MIN, int(int(saved_level()) * DIM_LEVEL)))
			log('dimmed after %d s' % t)
		if off_due:
			log('no activity for %d s' % t)
			threading.Thread(target=screen_off, args=(find(TOUCH), INACTIVITY), daemon=True).start()
			idle['off_since'] = now	# the thread sets it again; no second start meanwhile
		return True
	if idle['off_since'] is None:
		idle['off_since'] = now	# off by someone else (call proximity, start)
	if now - idle['off_since'] < SLEEP_AFTER or now - idle['resumed'] < idle.get('grace', RESUME_GRACE) or now < idle['next_try']:
		return True
	why = why_awake()
	idle['next_try'] = now + (15 if why else 60)	# a failed / inhibited suspend: try again in a minute
	if why:
		log('screen off, stays awake: ' + why)
		return True
	log('screen off for %d s, suspending' % (now - idle['off_since']))
	threading.Thread(target=suspend, daemon=True).start()
	return True


def prepare_for_sleep(conn, sender, path, iface, signal, params):
	if params.unpack()[0]:
		log('going to sleep')
		return
	now = time.monotonic()
	idle['resumed'] = now
	idle['next_try'] = 0.0
	idle['grace'] = RESUME_GRACE
	try:
		irq = open('/sys/power/pm_wakeup_irq').read().strip() if os.path.exists('/sys/power/pm_wakeup_irq') else ''
	except OSError:
		irq = ''	# ENODATA: no interrupt behind this wake-up (modem: SMS / call over QMI), the sleep hook keeps the display dark
	dark = set()
	for line in open('/proc/interrupts'):
		f = line.split()
		if f and f[-1] in ('ce2', 'ipa'):
			dark.add(f[0].rstrip(':'))
	if irq in dark:
		if telegram_running():
			idle['grace'] = TG_GRACE
		log('resumed by irq %s (Wi-Fi / mobile data): screen stays off for %d s' % (irq, idle['grace']))
		return
	if not irq:
		log('resumed without irq (modem: SMS / call): screen stays off, a call or a key turns it on')
		return
	log('resumed by irq %s: screen on' % (irq or '?'))
	idle['key_ignore'] = now + 2	# the power key event of this wake-up comes right after
	if not screen_is_on():
		threading.Thread(target=screen_on, args=(find(TOUCH),), daemon=True).start()


def name_gone(conn, sender, path, iface, signal, params):
	name, old, new = params.unpack()
	if new or not name.startswith(':'):
		return
	for c in [c for c, s in idle['keep'].items() if s == name]:
		del idle['keep'][c]
		log('keepDisplayOn %d dropped (%s gone)' % (c, name))
	for c in [c for c, (s, n) in idle['sys'].items() if s == name]:
		del idle['sys'][c]
		log('requestSysState %s dropped (%s gone)' % (c, name))


def heartbeat():
	if screen_is_on():
		power_state(True, PROXIMITY)
	return True


def main():
	global bus
	bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
	Gio.bus_own_name_on_connection(bus, NAME, Gio.BusNameOwnerFlags.NONE,
		lambda c, n: (log('owns ' + n), heartbeat()), lambda c, n: log('lost ' + n))
	GLib.timeout_add_seconds(15, heartbeat)
	watch_orientation()
	repowerd()
	threading.Thread(target=keys, daemon=True).start()
	watch_activity()
	read_timeouts()
	watch_settings()
	bus.signal_subscribe('org.freedesktop.login1', 'org.freedesktop.login1.Manager', 'PrepareForSleep',
		'/org/freedesktop/login1', None, Gio.DBusSignalFlags.NONE, prepare_for_sleep)
	bus.signal_subscribe('org.freedesktop.DBus', 'org.freedesktop.DBus', 'NameOwnerChanged', '/org/freedesktop/DBus',
		None, Gio.DBusSignalFlags.NONE, name_gone)
	GLib.timeout_add_seconds(1, tick)
	GLib.MainLoop().run()


main()
