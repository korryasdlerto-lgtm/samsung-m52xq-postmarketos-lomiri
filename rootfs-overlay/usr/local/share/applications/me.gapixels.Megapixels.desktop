[Desktop Entry]
# m52xq (убунтутач24/003 v3): absolute Icon path — Lomiri did not find the hicolor icon by name (no icon in the app drawer)
Name=Megapixels
Exec=/usr/local/bin/m52xq-megapixels-lomiri
Terminal=false
Type=Application
Categories=GTK;Photography;Graphics;
Keywords=picture;photos;camera;
Icon=/usr/share/icons/hicolor/scalable/apps/me.gapixels.Megapixels.svg
X-Purism-FormFactor=Workstation;Mobile;
X-Phosh-UsesFeedback=true
StartupNotify=true
