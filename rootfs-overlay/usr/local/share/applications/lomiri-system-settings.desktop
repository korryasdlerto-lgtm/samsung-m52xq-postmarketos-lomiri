X-Lomiri-Touch=true
X-Lomiri-StageHint=SideStage
X-Lomiri-Single-Instance=true
X-Lomiri-Default-Department-ID=accessories
X-Lomiri-Splash-Image=/usr/share/lomiri-system-settings/system-settings-app-splash.svg
X-Lomiri-Splash-Color=#454545
