Icon=/usr/share/lomiri-system-settings/system-settings.svg
Exec=/usr/local/bin/m52xq-app-env lomiri-system-settings %u
MimeType=x-scheme-handler/settings;
Terminal=false
Type=Application
StartupNotify=true
