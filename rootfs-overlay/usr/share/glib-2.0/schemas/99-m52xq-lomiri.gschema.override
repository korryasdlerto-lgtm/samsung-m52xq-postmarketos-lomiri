[com.lomiri.touch.system]
orientation-lock='PortraitOrientation'
# v2: autorotation (iio-sensor-proxy + m52xq-powerkey re-reading the qtmir orientation sensor)
rotation-lock=false

[com.lomiri.Shell]
# the power/volume keys (pmic_pwrkey, pmic_resin, gpio-keys) are "keyboards" for Lomiri, so it took a hardware keyboard
# as attached and never showed the on-screen keyboard (oskEnabled: !hasKeyboard || alwaysShowOsk)
always-show-osk=true
# the cat on a square canvas: PreserveAspectCrop shows all of it in landscape and the whole face in portrait
# (16:9 lost the ears in landscape)
background-picture-uri='file:///usr/share/backgrounds/warty-final-ubuntu-square.png'
# the screenshot editor opened after every screenshot and could not be left: save the shot only
enable-screenshot-editor=false

[com.lomiri.Shell.Greeter]
# lock screen: the Ubuntu Touch default background (from the UT 24.04 image of 001), the desktop keeps the cat
background-picture-uri='file:///usr/share/backgrounds/ubuntu-touch/ubuntu-touch-default.png'

# Ubuntu Touch home button (logo from 001 ubuntutouch-artwork, orange as in UT) instead of the postmarketOS one
[com.lomiri.Shell.Launcher]
logo-picture-uri='file:///usr/share/pixmaps/m52xq-ubuntu-touch-logo.svg'
home-button-background-color='#E95420'
# the launcher list by default named Ubuntu Touch apps (dialer-app, messaging-app, addressbook, click packages) that do not
# exist here: only what is installed; calls / SMS = plasma-dialer / spacebar (lomiri-telephony-service-call/sms are only its handlers)
items=['application:///org.kde.plasma.dialer.desktop', 'application:///org.kde.spacebar.desktop', 'application:///lomiri-system-settings.desktop', 'application:///lomiri-camera-app.desktop', 'application:///me.gapixels.Megapixels.desktop', 'application:///io.github.rinigus.PureMaps.desktop', 'application:///org.telegram.desktop.desktop', 'application:///morph-browser.desktop', 'application:///firefox.desktop', 'application:///lomiri-weather-app.desktop', 'application:///lomiri-terminal-app.desktop', 'application:///lomiri-clock-app.desktop', 'application:///lomiri-gallery-app.desktop', 'application:///lomiri-calculator-app.desktop', 'application:///lomiri-filemanager-app.desktop', 'application:///m52xq-sim-mode.desktop', 'application:///m52xq-reboot-recovery.desktop', 'application:///org.kde.discover.desktop']

# on-screen keyboard: Russian + English (switch with the globe key)
[org.maliit.keyboard.maliit]
enabled-languages=['ru', 'en']
active-language='ru'
